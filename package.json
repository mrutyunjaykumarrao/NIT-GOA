{
  "name": "nitgoa-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "NIT Goa Official Website - Full Stack Application",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install-all": "npm install && npm run install-client && npm run install-server",
    "install-client": "cd client && npm install",
    "install-server": "cd server && npm install",
    "dev": "concurrently \"npm run dev-server\" \"npm run dev-client\"",
    "dev-client": "cd client && npm start",
    "dev-server": "cd server && npm run dev",
    "build": "cd client && npm run build",
    "test": "npm run test-client && npm run test-server",
    "test-client": "cd client && npm test",
    "test-server": "cd server && npm test",
    "lint": "npm run lint-client && npm run lint-server",
    "lint-client": "cd client && npm run lint",
    "lint-server": "cd server && npm run lint",
    "deploy": "npm run build && firebase deploy",
    "deploy:staging": "npm run build && firebase hosting:channel:deploy staging",
    "serve": "firebase serve --only hosting",
    "start-server": "cd server && npm start",
    "start-client": "cd client && npm start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6"
  },
  "keywords": [
    "nitgoa",
    "nit-goa",
    "education",
    "website",
    "fullstack"
  ],
  "author": "NIT Goa Development Team",
  "license": "MIT"
}
