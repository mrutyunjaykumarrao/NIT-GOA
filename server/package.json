{
  "name": "nitgoa-server",
  "version": "2.0.0",
  "description": "Enhanced Backend API for NIT Goa website with updated database schema",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:updated": "node server.updated.js",
    "dev": "nodemon server.js",
    "dev:updated": "nodemon server.updated.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:db": "node test-db.js",
    "test:db:updated": "node -e \"require('./src/config/database.updated').testConnection()\"",
    "migrate": "node ../scripts/migrate-database.js",
    "setup:db": "mysql -u root -p < ../database/schemas/updated_nitgoa_schema.sql",
    "lint": "eslint src/**/*.js --quiet",
    "lint:fix": "eslint src/**/*.js --fix"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "bcrypt": "^5.1.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^1.41.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.6.0",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.10.1",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "keywords": [
    "nitgoa",
    "api",
    "express",
    "mysql"
  ],
  "author": "NIT Goa Development Team",
  "license": "MIT"
}
