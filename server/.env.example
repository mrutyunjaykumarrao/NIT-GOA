# =================================================================
# NIT GOA Backend Environment Configuration Template
# Copy this file to .env and fill in your actual values
# =================================================================

# Server Environment Variables
NODE_ENV=development
PORT=3001

# Database Configuration
# =================================================================
# Choose your database by setting DB_NAME:
# - For Original Database: nitgoa_db
# - For Enhanced Database: updated_nitgoa
# =================================================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=nitgoa_db
DB_PORT=3306
DB_SSL=false

# Alternative Database Names (for reference)
# DB_NAME=nitgoa_db          # Original database
# DB_NAME=updated_nitgoa     # Enhanced database with 18 tables

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# File Upload Configuration
MAX_FILE_SIZE=5242880

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# File Upload Configuration (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# Security Configuration
BCRYPT_ROUNDS=12
